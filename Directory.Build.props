<Project>
  <!--
    veraPDF engine: the greenfield-apps fat jar is downloaded from Maven Central
    at build time (see src/Legibyl.Validation/Legibyl.Validation.fsproj) and
    verified against VeraPdfSha256. To upgrade, change these two values, then
    reset VersionBuild to 0.

    Versioning convention for this repo: the first three components track the
    veraPDF engine version, and the fourth component is a build/revision number
    for this tool that increments independently of the engine.
  -->
  <PropertyGroup>
    <VeraPdfVersion>1.28.1</VeraPdfVersion>
    <VeraPdfSha256>916049DB6C6335A4A4C624E098499CFF152EF523F65693A0D835AEC635B6DCBC</VeraPdfSha256>
    <!-- Tesseract's English and Spanish OCR models (tessdata_fast, Apache-2.0), fetched by
         Legibyl.Layout's build like the veraPDF jar and copied into the output's built-in
         language packs, languages/en and languages/es. -->
    <TessdataVersion>4.1.0</TessdataVersion>
    <TessdataEngSha256>7D4322BD2A7749724879683FC3912CB542F19906C83BCC1A52132556427170B2</TessdataEngSha256>
    <TessdataSpaSha256>6F2E04D02774A18F01BED44B1111F2CD7F3BA7AC9DC4373CD3F898A40EA6B464</TessdataSpaSha256>
    <!-- The models Suggest Structure runs, bundled with the app and the CLI (fetched by
         Legibyl.Layout's build like tessdata, and copied to the output under models/): the layout
         detector (PP-DocLayoutV3, Apache-2.0, PaddlePaddle's own files on Hugging Face) and the
         table-structure model (Table Transformer v1.0, MIT, Xenova's 8-bit ONNX export), each at a
         fixed revision, each file pinned by its SHA-256. -->
    <LayoutModelRevision>241f8bdfc77a7c7bee915a5057aaee58c235a8d3</LayoutModelRevision>
    <LayoutModelJsonSha256>2B68367C5B312A03DE5A6E1642C597C8F95165A7E40CD59C6700CF4A5042F4FD</LayoutModelJsonSha256>
    <LayoutModelParamsSha256>70BD316B0582769EC968829FD1FEB1A6A58B7C941B938327E551B6B12B45C137</LayoutModelParamsSha256>
    <LayoutModelYmlSha256>506FCFAC13B3B546AE40D7886B44126420F392ADB694E3F8BB6A6286A1F90FDC</LayoutModelYmlSha256>
    <TableModelRevision>5387550de655512721e1b88e4e42117001ba4813</TableModelRevision>
    <TableModelSha256>C11F4033DA75E9C4D41C403EF356E89CAA0A37A7D111B55461E7D5BA856BB6B6</TableModelSha256>
    <!-- The fonts the embed-fonts fix embeds in place of fonts a PDF doesn't (fetched by
         Legibyl.Validation's build like tessdata, and copied to the output under fonts/): URW's
         base 35 (AGPL-3.0 with a font exception), metric clones of the PostScript standard 14, each
         file pinned by its SHA-256 in Legibyl.Validation.fsproj; and Liberation (SIL OFL 1.1),
         metric clones of Arial, Times New Roman and Courier New, the release's archive pinned here. -->
    <UrwFontsVersion>20200910</UrwFontsVersion>
    <LiberationFontsVersion>2.1.5</LiberationFontsVersion>
    <LiberationFontsSha256>7191C669BF38899F73A2094ED00F7B800553364F90E2637010A69C0E268F25D0</LiberationFontsSha256>
  </PropertyGroup>

  <PropertyGroup>
    <VersionPrefix>$(VeraPdfVersion)</VersionPrefix>
    <VersionBuild>0</VersionBuild>
    <Version>$(VersionPrefix).$(VersionBuild)</Version>
    <PackageLicenseExpression>AGPL-3.0-or-later</PackageLicenseExpression>
  </PropertyGroup>

  <!-- Legibyl's own copyright, stamped into each assembly (and the macOS bundle's Info.plist);
       About and the CLI's version say it from there. -->
  <PropertyGroup>
    <Authors>Ekon Benefits</Authors>
    <Company>Ekon Benefits</Company>
    <Product>Legibyl</Product>
    <Copyright>Copyright © 2026 Ekon Benefits</Copyright>
  </PropertyGroup>
</Project>
