<Project>
  <!--
    veraPDF engine: the greenfield-apps fat jar is downloaded from Maven Central
    at build time (see src/Legibyl.Validation/Legibyl.Validation.fsproj) and
    verified against VeraPdfSha256. To upgrade, change these two values, then
    reset VersionBuild to 0.

    Versioning convention for this repo: the first three components track the
    veraPDF engine version, and the fourth component is a build/revision number
    for this tool that increments independently of the engine.
  -->
  <PropertyGroup>
    <VeraPdfVersion>1.28.1</VeraPdfVersion>
    <VeraPdfSha256>916049DB6C6335A4A4C624E098499CFF152EF523F65693A0D835AEC635B6DCBC</VeraPdfSha256>
    <!-- Tesseract's English OCR model (tessdata_fast, Apache-2.0), fetched by Legibyl.Layout's
         build like the veraPDF jar and copied to the output under tessdata/. -->
    <TessdataVersion>4.1.0</TessdataVersion>
    <TessdataEngSha256>7D4322BD2A7749724879683FC3912CB542F19906C83BCC1A52132556427170B2</TessdataEngSha256>
  </PropertyGroup>

  <PropertyGroup>
    <VersionPrefix>$(VeraPdfVersion)</VersionPrefix>
    <VersionBuild>0</VersionBuild>
    <Version>$(VersionPrefix).$(VersionBuild)</Version>
    <PackageLicenseExpression>AGPL-3.0-or-later</PackageLicenseExpression>
  </PropertyGroup>

  <!-- Legibyl's own copyright, stamped into each assembly (and the macOS bundle's Info.plist);
       About and the CLI's version say it from there. -->
  <PropertyGroup>
    <Authors>Ekon Benefits</Authors>
    <Company>Ekon Benefits</Company>
    <Product>Legibyl</Product>
    <Copyright>Copyright © 2026 Ekon Benefits</Copyright>
  </PropertyGroup>
</Project>
