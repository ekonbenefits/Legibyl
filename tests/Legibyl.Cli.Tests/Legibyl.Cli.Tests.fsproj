<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <OutputType>Exe</OutputType>
    <!-- Run under the VSTest adapter so plain `dotnet test` works on the .NET 10 SDK. -->
    <UseMicrosoftTestingPlatformRunner>false</UseMicrosoftTestingPlatformRunner>
    <IsTestingPlatformApplication>false</IsTestingPlatformApplication>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="FixNamesTests.fs" />
    <Compile Include="CommandLineTests.fs" />
    <Compile Include="FigureRegionTests.fs" />
    <Compile Include="LayoutFileTests.fs" />
    <Compile Include="AppendCommandTests.fs" />
    <Compile Include="WcagCommandTests.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="FsUnit.xUnit" />
    <PackageReference Include="itext" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Legibyl.Cli\Legibyl.Cli.fsproj" />
  </ItemGroup>

</Project>
