<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <OutputType>Exe</OutputType>
    <!-- Run under the VSTest adapter so plain `dotnet test` works on the .NET 10 SDK. -->
    <UseMicrosoftTestingPlatformRunner>false</UseMicrosoftTestingPlatformRunner>
    <IsTestingPlatformApplication>false</IsTestingPlatformApplication>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="TestSupport.fs" />
    <Compile Include="VeraPdfValidatorTests.fs" />
    <Compile Include="PdfLocationParserTests.fs" />
    <Compile Include="ValidationReportTextFormatterTests.fs" />
    <Compile Include="StructureTreeReaderTests.fs" />
    <Compile Include="PdfFixerTests.fs" />
    <Compile Include="PdfRegionRendererTests.fs" />
    <Compile Include="TechniqueSampleTests.fs" />
    <Compile Include="TocHeadingsTests.fs" />
    <Compile Include="ParagraphListsTests.fs" />
    <Compile Include="ParagraphJoinsTests.fs" />
    <Compile Include="EmbeddedReviewTests.fs" />
    <Compile Include="CopyNamesTests.fs" />
    <Compile Include="ElementEditsTests.fs" />
    <Compile Include="BookmarksTests.fs" />
    <Compile Include="EmptyTocEntriesTests.fs" />
    <Compile Include="LayoutSuggestionsTests.fs" />
    <Compile Include="LayoutTaggingTests.fs" />
    <Compile Include="DocumentLanguageTests.fs" />
    <Compile Include="MetadataAndFontFixTests.fs" />
    <Compile Include="LinkTitlesTests.fs" />
    <Compile Include="LinkTargetsTests.fs" />
    <Compile Include="ParentTreeTests.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="FsUnit.xUnit" />
    <PackageReference Include="itext" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="YamlDotNet" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Legibyl.Validation\Legibyl.Validation.fsproj" />
    <ProjectReference Include="..\..\src\Legibyl.Rendering\Legibyl.Rendering.fsproj" />
    <ProjectReference Include="..\..\src\Legibyl.Layout\Legibyl.Layout.fsproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="SampleCorpus\**\*.pdf;SampleCorpus\**\*.yaml;SampleCorpus\**\*.ttf" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
