<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <OutputType>Exe</OutputType>
    <!-- Run under the VSTest adapter so plain `dotnet test` works on the .NET 10 SDK. -->
    <UseMicrosoftTestingPlatformRunner>false</UseMicrosoftTestingPlatformRunner>
    <IsTestingPlatformApplication>false</IsTestingPlatformApplication>
  </PropertyGroup>

  <ItemGroup>
    <!-- Shared with the screenshot tool: drives MainWindow on Avalonia's headless platform. -->
    <Compile Include="..\..\tools\Legibyl.Screenshots\HeadlessWindow.fs" Link="HeadlessWindow.fs" />
    <Compile Include="HeadlessSession.fs" />
    <Compile Include="MainWindowTests.fs" />
    <Compile Include="StructureTreeWindowTests.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Headless" Version="12.1.3" />
    <PackageReference Include="Avalonia.Skia" Version="12.1.3" />
    <PackageReference Include="FsUnit.xUnit" Version="7.1.1" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageReference Include="xunit.v3" Version="4.0.1" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Legibyl.Gui\Legibyl.Gui.fsproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\Legibyl.Validation.Tests\SampleCorpus\*.pdf" Link="SampleCorpus\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
