<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <OutputType>Exe</OutputType>
    <!-- Run under the VSTest adapter so plain `dotnet test` works on the .NET 10 SDK. -->
    <UseMicrosoftTestingPlatformRunner>false</UseMicrosoftTestingPlatformRunner>
    <IsTestingPlatformApplication>false</IsTestingPlatformApplication>
  </PropertyGroup>

  <ItemGroup>
    <!-- Shared with the screenshot tool: drives MainWindow on Avalonia's headless platform. -->
    <Compile Include="..\..\tools\Legibyl.Screenshots\HeadlessWindow.fs" Link="HeadlessWindow.fs" />
    <Compile Include="HeadlessSession.fs" />
    <Compile Include="Reviews.fs" />
    <Compile Include="MainWindowTests.fs" />
    <Compile Include="StructureTreeWindowTests.fs" />
    <Compile Include="StructureEditsTests.fs" />
    <Compile Include="RoleMapTabTests.fs" />
    <Compile Include="DescriptionEditTests.fs" />
    <Compile Include="TableRebuildTests.fs" />
    <Compile Include="LayoutOrderTests.fs" />
    <Compile Include="StructureBlockSelectionTests.fs" />
    <Compile Include="BlocksPreviewTests.fs" />
    <Compile Include="TableLayoutTests.fs" />
    <Compile Include="FindingMarkersTests.fs" />
    <Compile Include="SavedValidationTests.fs" />
    <Compile Include="PassChecklistTests.fs" />
    <Compile Include="NextStepTests.fs" />
    <Compile Include="UntaggedStructureTests.fs" />
    <Compile Include="StructureCacheTests.fs" />
    <Compile Include="DismissalsTests.fs" />
    <Compile Include="RegionEditsTests.fs" />
    <Compile Include="FigureRegionTests.fs" />
    <Compile Include="EmbeddedReviewTests.fs" />
    <Compile Include="LinkTitleOfferTests.fs" />
    <Compile Include="DismissWarningsTests.fs" />
    <Compile Include="FixDialogTests.fs" />
    <Compile Include="SaveWorkflowTests.fs" />
    <Compile Include="BusyStatusTests.fs" />
    <Compile Include="SuggestedStructureTests.fs" />
    <Compile Include="DocumentWindowsTests.fs" />
    <Compile Include="RecentFilesTests.fs" />
    <Compile Include="AboutTests.fs" />
    <Compile Include="AccessibilityTests.fs" />
    <Compile Include="AppendDialogTests.fs" />
    <Compile Include="DocumentLanguageRowTests.fs" />
    <Compile Include="FailureReportingTests.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Headless" />
    <PackageReference Include="Avalonia.Skia" />
    <PackageReference Include="FsUnit.xUnit" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Legibyl.Gui\Legibyl.Gui.fsproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\Legibyl.Validation.Tests\SampleCorpus\*.pdf" Link="SampleCorpus\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\Legibyl.Validation.Tests\SampleCorpus\fonts\*.ttf" Link="SampleCorpus\fonts\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
