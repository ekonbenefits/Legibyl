<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- Layout suggestions reuse the list marker rules (ParagraphLists). -->
    <InternalsVisibleTo Include="Legibyl.Layout" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="Tags.fs" />
    <Compile Include="Destinations.fs" />
    <Compile Include="Types.fs" />
    <Compile Include="PdfUaTarget.fs" />
    <Compile Include="PdfLocationParser.fs" />
    <Compile Include="Results.fs" />
    <Compile Include="ValidationReportTextFormatter.fs" />
    <Compile Include="Interop.fs" />
    <Compile Include="Pdfium.fs" />
    <Compile Include="ContrastRasterizer.fs" />
    <Compile Include="ValidatorLog.fs" />
    <Compile Include="WebAddressText.fs" />
    <Compile Include="MarkedContentTextIndex.fs" />
    <Compile Include="StructureTreeObjects.fs" />
    <Compile Include="DocumentLanguage.fs" />
    <Compile Include="LanguagePacks.fs" />
    <Compile Include="PassageLanguages.fs" />
    <Compile Include="SplitWordSpans.fs" />
    <Compile Include="ContentOperators.fs" />
    <Compile Include="ContentOperations.fs" />
    <Compile Include="MarkedContentSplit.fs" />
    <Compile Include="ContentArtifacts.fs" />
    <Compile Include="ParentTree.fs" />
    <Compile Include="RoleMaps.fs" />
    <Compile Include="DocumentRoot.fs" />
    <Compile Include="Attachments.fs" />
    <Compile Include="TocHeadings.fs" />
    <Compile Include="ParagraphLists.fs" />
    <Compile Include="ParagraphTables.fs" />
    <Compile Include="ParagraphJoins.fs" />
    <Compile Include="SplitFigures.fs" />
    <Compile Include="Bookmarks.fs" />
    <Compile Include="LinkTargets.fs" />
    <Compile Include="LinkTitles.fs" />
    <Compile Include="UnlinkedUrls.fs" />
    <Compile Include="TableGrid.fs" />
    <Compile Include="LayoutTagging.fs" />
    <Compile Include="UntaggedContent.fs" />
    <Compile Include="DisconnectedContent.fs" />
    <Compile Include="FigureRegion.fs" />
    <Compile Include="TableRebuild.fs" />
    <Compile Include="ParagraphTableRebuild.fs" />
    <Compile Include="ElementEdits.fs" />
    <Compile Include="EmptyFigures.fs" />
    <Compile Include="PredefinedCMaps.fs" />
    <Compile Include="ToUnicodeMaps.fs" />
    <Compile Include="FontEmbedding.fs" />
    <Compile Include="StructureFixes.fs" />
    <Compile Include="DocumentTitles.fs" />
    <Compile Include="DocumentFacts.fs" />
    <!-- Legibyl's own warnings; see the header of LegibylChecks.fs to add one. -->
    <Compile Include="LegibylChecks.fs" />
    <Compile Include="FindingGeometry.fs" />
    <Compile Include="StructureTreeWalk.fs" />
    <Compile Include="MetadataTransfer.fs" />
    <Compile Include="CopyNames.fs" />
    <Compile Include="EmbeddedReview.fs" />
    <Compile Include="LayoutFile.fs" />
    <!-- The built-in language packs (English and Spanish; see LanguagePacks), copied to the
         output's languages/ as the folders anyone else's pack is dropped in as. -->
    <None Include="../../languages/**/*" Link="languages/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <!-- The text RuleGuide.fs reads, embedded so the CLI and the app need no file beside them. -->
    <EmbeddedResource Include="RuleGuide.yaml" LogicalName="Legibyl.Validation.RuleGuide.yaml" />
    <Compile Include="RuleGuide.fs" />
    <Compile Include="FixNames.fs" />
    <Compile Include="ReviewFile.fs" />
    <Compile Include="VeraPdfValidator.fs" />
    <Compile Include="BuildInfo.fs" />
    <Compile Include="SavedResults.fs" />
    <Compile Include="Append.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="IKVM" />
    <PackageReference Include="itext" />
    <!-- Detects the document's language from its text, for its /Lang (Apache 2.0). -->
    <PackageReference Include="LanguageDetection.NETStandard" />
    <!-- Used only to read marked-content text runs (by page + MCID) for structure-tree
         content extraction; pure managed, Apache 2.0, no native/PDFium dependency. -->
    <PackageReference Include="PdfPig" />
    <!-- PDFium draws pages (Chrome's renderer; BSD-3), from bblanchon's native builds for
         Windows, Linux and macOS: for WCAG's contrast check here, and for Legibyl.Rendering. -->
    <PackageReference Include="bblanchon.PDFium.Linux" />
    <PackageReference Include="bblanchon.PDFium.macOS" />
    <PackageReference Include="bblanchon.PDFium.Win32" />
    <!-- Reads RuleGuide.yaml (MIT). -->
    <PackageReference Include="YamlDotNet" />
  </ItemGroup>

  <!-- veraPDF fat jar: fetched from Maven Central on first build, pinned by
       VeraPdfVersion/VeraPdfSha256 in Directory.Build.props, cached under obj/. -->
  <PropertyGroup>
    <VeraPdfJarName>greenfield-apps-$(VeraPdfVersion).jar</VeraPdfJarName>
    <VeraPdfJarUrl>https://repo1.maven.org/maven2/org/verapdf/apps/greenfield-apps/$(VeraPdfVersion)/$(VeraPdfJarName)</VeraPdfJarUrl>
    <VeraPdfJarDir>$(MSBuildProjectDirectory)/$(BaseIntermediateOutputPath)verapdf/</VeraPdfJarDir>
    <VeraPdfJar>$(VeraPdfJarDir)$(VeraPdfJarName)</VeraPdfJar>
  </PropertyGroup>

  <!-- veraPDF's WCAG 2.2 checks, pinned here (see lib/vendor/verapdf-jars/README.md), cached
       beside the veraPDF jar. The WCAG model is found by name (Class.forName) from veraPDF's own
       code, so they're compiled into one assembly with it. Their contrast check draws pages with
       PDFium, through java/wcag-contrast.jar (see java/README.md): wcag-algorithms goes in
       without veraPDF's own ContrastRatioConsumer, which drew them with PDFBox. -->
  <ItemGroup>
    <VeraPdfWcagJar Include="org/verapdf/wcag-validation/$(VeraPdfVersion)/wcag-validation-$(VeraPdfVersion).jar" Sha256="56C45553D313A369BE7D027CE539B40B119783B910E1CB51B12CCC99A61B769A" />
    <VeraPdfWcagJar Include="org/verapdf/wcag-algorithms/$(VeraPdfVersion)/wcag-algorithms-$(VeraPdfVersion).jar" Sha256="D03E7493D51AB770B3B33FC3EA7E730D6ABABD8E63B46DBFBD6F8BE7FA11D4DA" />
  </ItemGroup>

  <PropertyGroup>
    <WcagAlgorithmsJar>$(VeraPdfJarDir)wcag-algorithms-$(VeraPdfVersion).jar</WcagAlgorithmsJar>
    <WcagAlgorithmsRepacked>$(VeraPdfJarDir)wcag-algorithms-$(VeraPdfVersion)-legibyl.jar</WcagAlgorithmsRepacked>
  </PropertyGroup>

  <ItemGroup>
    <IkvmReference Include="$(VeraPdfJar)"
                   AssemblyName="verapdf"
                   AssemblyVersion="$(VeraPdfVersion).0"
                   AssemblyFileVersion="$(VeraPdfVersion).0"
                   Compile="$(VeraPdfJar);$(VeraPdfJarDir)wcag-validation-$(VeraPdfVersion).jar;$(WcagAlgorithmsRepacked);$(MSBuildProjectDirectory)/java/wcag-contrast.jar" />
    <!-- veraPDF's WCAG 2.2 machine-checkable rules, as its v1.28.1 release has them (see
         WcagProfile). -->
    <EmbeddedResource Include="Profiles/WCAG-2-2-Machine.xml" LogicalName="WCAG-2-2-Machine.xml" />
  </ItemGroup>

  <Target Name="FetchVeraPdfWcagJars" BeforeTargets="GetIkvmReferenceItemsFromIkvmReferences">
    <DownloadFile SourceUrl="https://repo1.maven.org/maven2/%(VeraPdfWcagJar.Identity)" DestinationFolder="$(VeraPdfJarDir)" DestinationFileName="%(VeraPdfWcagJar.Filename)%(VeraPdfWcagJar.Extension).download" Retries="3" Condition="!Exists('$(VeraPdfJarDir)%(VeraPdfWcagJar.Filename)%(VeraPdfWcagJar.Extension)')" />
    <VerifyFileHash File="$(VeraPdfJarDir)%(VeraPdfWcagJar.Filename)%(VeraPdfWcagJar.Extension).download" Hash="%(VeraPdfWcagJar.Sha256)" Algorithm="SHA256" Condition="!Exists('$(VeraPdfJarDir)%(VeraPdfWcagJar.Filename)%(VeraPdfWcagJar.Extension)')" />
    <Move SourceFiles="$(VeraPdfJarDir)%(VeraPdfWcagJar.Filename)%(VeraPdfWcagJar.Extension).download" DestinationFiles="$(VeraPdfJarDir)%(VeraPdfWcagJar.Filename)%(VeraPdfWcagJar.Extension)" Condition="!Exists('$(VeraPdfJarDir)%(VeraPdfWcagJar.Filename)%(VeraPdfWcagJar.Extension)')" />
  </Target>

  <!-- wcag-algorithms less veraPDF's ContrastRatioConsumer (and its DataPoint), so the one in
       java/wcag-contrast.jar is the only one. -->
  <Target Name="RepackWcagAlgorithms" AfterTargets="FetchVeraPdfWcagJars" BeforeTargets="GetIkvmReferenceItemsFromIkvmReferences" Condition="!Exists('$(WcagAlgorithmsRepacked)')">
    <PropertyGroup>
      <_WcagRepackDir>$(VeraPdfJarDir)wcag-algorithms-repack/</_WcagRepackDir>
    </PropertyGroup>
    <RemoveDir Directories="$(_WcagRepackDir)" />
    <Unzip SourceFiles="$(WcagAlgorithmsJar)" DestinationFolder="$(_WcagRepackDir)" />
    <ItemGroup>
      <_WcagConsumerClass Include="$(_WcagRepackDir)org/verapdf/wcag/algorithms/semanticalgorithms/consumers/ContrastRatioConsumer*.class" />
    </ItemGroup>
    <Error Condition="'@(_WcagConsumerClass)' == ''" Text="wcag-algorithms has no ContrastRatioConsumer to replace: compare veraPDF's new release with java/README.md." />
    <Delete Files="@(_WcagConsumerClass)" />
    <ZipDirectory SourceDirectory="$(_WcagRepackDir)" DestinationFile="$(WcagAlgorithmsRepacked).tmp" Overwrite="true" />
    <Move SourceFiles="$(WcagAlgorithmsRepacked).tmp" DestinationFiles="$(WcagAlgorithmsRepacked)" />
    <RemoveDir Directories="$(_WcagRepackDir)" />
  </Target>

  <Target Name="FetchVeraPdfJar" BeforeTargets="GetIkvmReferenceItemsFromIkvmReferences" Condition="!Exists('$(VeraPdfJar)')">
    <DownloadFile SourceUrl="$(VeraPdfJarUrl)" DestinationFolder="$(VeraPdfJarDir)" DestinationFileName="$(VeraPdfJarName).download" Retries="3" />
    <GetFileHash Files="$(VeraPdfJar).download" Algorithm="SHA256">
      <Output TaskParameter="Hash" PropertyName="_VeraPdfActualSha256" />
    </GetFileHash>
    <Delete Files="$(VeraPdfJar).download" Condition="'$(_VeraPdfActualSha256)' != '$(VeraPdfSha256)'" />
    <Error Condition="'$(_VeraPdfActualSha256)' != '$(VeraPdfSha256)'"
           Text="SHA-256 mismatch for $(VeraPdfJarUrl): expected $(VeraPdfSha256), got $(_VeraPdfActualSha256). If you are upgrading veraPDF, update VeraPdfSha256 in Directory.Build.props." />
    <Move SourceFiles="$(VeraPdfJar).download" DestinationFiles="$(VeraPdfJar)" />
  </Target>

  <!-- The fonts the embed-fonts fix embeds (see BundledFonts), pinned in Directory.Build.props and
       here, cached under obj/ and copied to the output's fonts/. -->
  <PropertyGroup>
    <BundledFontsDir>$(MSBuildProjectDirectory)/$(BaseIntermediateOutputPath)fonts/</BundledFontsDir>
    <UrwFontsUrl>https://raw.githubusercontent.com/ArtifexSoftware/urw-base35-fonts/$(UrwFontsVersion)/fonts</UrwFontsUrl>
    <LiberationFontsName>liberation-fonts-ttf-$(LiberationFontsVersion)</LiberationFontsName>
    <LiberationFontsUrl>https://github.com/liberationfonts/liberation-fonts/files/7261482/$(LiberationFontsName).tar.gz</LiberationFontsUrl>
    <UrwFontsDir>$(BundledFontsDir)urw-$(UrwFontsVersion)/</UrwFontsDir>
    <LiberationFontsDir>$(BundledFontsDir)$(LiberationFontsName)/</LiberationFontsDir>
  </PropertyGroup>

  <ItemGroup>
    <UrwFont Include="D050000L.ttf" Sha256="1FBC322B557D2519023A3EF9C4FF998F514B63F95C07352E059B35E605E7B02D" />
    <UrwFont Include="NimbusMonoPS-Bold.ttf" Sha256="068C0AB2D516F9DA930421B75FA5DD00892764CF635C9E423E602E01C44BCB83" />
    <UrwFont Include="NimbusMonoPS-BoldItalic.ttf" Sha256="3B19993E134CD18BB4EE7C6A811A39EACF287D2F1F4B41121DE00DCF034C734D" />
    <UrwFont Include="NimbusMonoPS-Italic.ttf" Sha256="AB1FD6320A326643A9BE6BDDB65ABCF499A51F3EFAD5578F291302EBBC7A28BC" />
    <UrwFont Include="NimbusMonoPS-Regular.ttf" Sha256="BF749D47BF69F4BF6963833AFB66A3A5B6E62185BFFFAF068B7A1B3F0276BA82" />
    <UrwFont Include="NimbusRoman-Bold.ttf" Sha256="03A62D23942E51F48E42DA30F0C50E008C67F0E5D6DACF739B5117C15A2E0BFD" />
    <UrwFont Include="NimbusRoman-BoldItalic.ttf" Sha256="4B80D3617DA875D4FA789BF4698417117CF2C52A9E678038B3B5F490736CE39C" />
    <UrwFont Include="NimbusRoman-Italic.ttf" Sha256="B9111288E478CB36A23433DF28A54AAB49F9007663DDC877D35C7E0275724129" />
    <UrwFont Include="NimbusRoman-Regular.ttf" Sha256="47DBFF21EDE6F3B8428FFE9F8C7C4AC5F1E3C1BC33CD987CFE42E99E0298C495" />
    <UrwFont Include="NimbusSans-Bold.ttf" Sha256="148726BE75D2060A38DFD2E2637569F56C82AF9F671E97131023B47ADD06F2CB" />
    <UrwFont Include="NimbusSans-BoldItalic.ttf" Sha256="F02DD8D808C9BF70323810C3F3F4EBFD4BB0D6DA97B28E584869D26815AFE7EB" />
    <UrwFont Include="NimbusSans-Italic.ttf" Sha256="225992B14BD46CE8FEEF45D4A46A0A950BF21042691B534293DED0B98BE15D8F" />
    <UrwFont Include="NimbusSans-Regular.ttf" Sha256="DF5D1CE7B86C2E74974008623612BAE136123A35BA7885DE8A0721B68258EDBC" />
    <UrwFont Include="StandardSymbolsPS.ttf" Sha256="CBB297E02AFF8F3067B1C53C3047DCD42DEC6B420A6766D640D2D0CBE223C0E5" />
    <LiberationFont Include="LiberationSans-Regular.ttf" />
    <LiberationFont Include="LiberationSans-Bold.ttf" />
    <LiberationFont Include="LiberationSans-Italic.ttf" />
    <LiberationFont Include="LiberationSans-BoldItalic.ttf" />
    <LiberationFont Include="LiberationSerif-Regular.ttf" />
    <LiberationFont Include="LiberationSerif-Bold.ttf" />
    <LiberationFont Include="LiberationSerif-Italic.ttf" />
    <LiberationFont Include="LiberationSerif-BoldItalic.ttf" />
    <LiberationFont Include="LiberationMono-Regular.ttf" />
    <LiberationFont Include="LiberationMono-Bold.ttf" />
    <LiberationFont Include="LiberationMono-Italic.ttf" />
    <LiberationFont Include="LiberationMono-BoldItalic.ttf" />
    <None Include="@(UrwFont->'$(UrwFontsDir)%(Identity)')" Link="fonts/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" Visible="false" />
    <None Include="@(LiberationFont->'$(LiberationFontsDir)%(Identity)')" Link="fonts/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>

  <Target Name="FetchBundledFonts" BeforeTargets="AssignTargetPaths;GetCopyToOutputDirectoryItems">
    <DownloadFile SourceUrl="$(UrwFontsUrl)/%(UrwFont.Identity)" DestinationFolder="$(UrwFontsDir)" DestinationFileName="%(UrwFont.Identity).download" Retries="3" Condition="!Exists('$(UrwFontsDir)%(UrwFont.Identity)')" />
    <VerifyFileHash File="$(UrwFontsDir)%(UrwFont.Identity).download" Hash="%(UrwFont.Sha256)" Algorithm="SHA256" Condition="!Exists('$(UrwFontsDir)%(UrwFont.Identity)')" />
    <Move SourceFiles="$(UrwFontsDir)%(UrwFont.Identity).download" DestinationFiles="$(UrwFontsDir)%(UrwFont.Identity)" Condition="!Exists('$(UrwFontsDir)%(UrwFont.Identity)')" />
    <!-- Liberation comes as one archive, its fonts in a folder of its name (tar is on Windows 10
         and later, macOS and Linux). -->
    <DownloadFile SourceUrl="$(LiberationFontsUrl)" DestinationFolder="$(BundledFontsDir)" DestinationFileName="$(LiberationFontsName).tar.gz" Retries="3" Condition="!Exists('$(LiberationFontsDir)LICENSE')" />
    <VerifyFileHash File="$(BundledFontsDir)$(LiberationFontsName).tar.gz" Hash="$(LiberationFontsSha256)" Algorithm="SHA256" Condition="!Exists('$(LiberationFontsDir)LICENSE')" />
    <Exec Command="tar -xzf &quot;$(LiberationFontsName).tar.gz&quot;" WorkingDirectory="$(BundledFontsDir)" Condition="!Exists('$(LiberationFontsDir)LICENSE')" />
    <Delete Files="$(BundledFontsDir)$(LiberationFontsName).tar.gz" />
  </Target>

  <ItemGroup>
    <!-- The veraPDF version its results come from (see VeraPdfValidator.EngineVersion). -->
    <AssemblyMetadata Include="VeraPdfVersion" Value="$(VeraPdfVersion)" />
    <!-- The bundled fonts' versions (see BuildInfo.validationComponents). -->
    <AssemblyMetadata Include="UrwFontsVersion" Value="$(UrwFontsVersion)" />
    <AssemblyMetadata Include="LiberationFontsVersion" Value="$(LiberationFontsVersion)" />
  </ItemGroup>

</Project>
