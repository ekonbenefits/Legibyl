<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Legibyl.Validation\Legibyl.Validation.fsproj" />
    <ProjectReference Include="..\Legibyl.Layout\Legibyl.Layout.fsproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <AssemblyName>legibyl</AssemblyName>
    <RootNamespace>Legibyl.Cli</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="ProfileNames.fs" />
    <Compile Include="Results.fs" />
    <Compile Include="FixNames.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FSharp.SystemCommandLine" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyMetadata Include="VeraPdfVersion" Value="$(VeraPdfVersion)" />
  </ItemGroup>

</Project>
