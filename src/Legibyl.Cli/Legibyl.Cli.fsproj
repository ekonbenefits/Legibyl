<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Legibyl.Validation\Legibyl.Validation.fsproj" />
    <ProjectReference Include="..\Legibyl.Layout\Legibyl.Layout.fsproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <AssemblyName>legibyl</AssemblyName>
    <RootNamespace>Legibyl.Cli</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <!--
    Published for a runtime (osx-arm64, win-x64...), code is compiled ahead of time (ReadyToRun),
    so a run starts faster: a cold `validate` of a small PDF took ~1.85 s instead of ~2.16 s.
    Except IKVM.Java.dll (the Java class library): compiling it too saved another ~0.35 s but
    made the publish 100 MB larger. See #16.
  -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <PublishReadyToRun>true</PublishReadyToRun>
  </PropertyGroup>
  <ItemGroup>
    <PublishReadyToRunExclude Include="IKVM.Java.dll" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="Results.fs" />
    <Compile Include="FixNames.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FSharp.SystemCommandLine" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyMetadata Include="VeraPdfVersion" Value="$(VeraPdfVersion)" />
  </ItemGroup>

</Project>
