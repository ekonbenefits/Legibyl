<Window x:Class="Legibyl.Gui.StructureTreeWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Legibyl.Gui"
        xmlns:validation="clr-namespace:Legibyl.Validation;assembly=Legibyl.Validation"
        Title="Document Structure" Height="700" Width="820"
        MinHeight="400" MinWidth="500">
    <Window.Resources>
        <local:StructureSummaryConverter x:Key="StructureSummaryConverter" />
    </Window.Resources>

    <Grid Margin="12" RowDefinitions="Auto,*,Auto">

        <TextBlock Grid.Row="0" Margin="0,0,0,8" TextWrapping="Wrap" Foreground="#FF555555"
                   Text="This is the tagged logical structure tree — the semantic heading/paragraph/list/table/link hierarchy that determines what content and reading order a screen reader presents to a user. Only elements that directly own page content show a page number." />

        <TabControl Grid.Row="1">
            <TabItem Header="Layout">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*" MinWidth="320" />
                        <ColumnDefinition Width="6" />
                        <ColumnDefinition Width="2*" MinWidth="260" />
                    </Grid.ColumnDefinitions>

                    <ScrollViewer x:Name="LayoutScrollViewer" Grid.Column="0"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled" Background="White">
                        <ContentControl x:Name="LayoutHost" Margin="8" />
                    </ScrollViewer>

                    <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch"
                                  Background="#FFE0E0E0" ResizeDirection="Columns" />

                    <Grid Grid.Column="2" Margin="10,0,0,0" RowDefinitions="Auto,Auto,*">
                        <TextBlock Text="Selected block geometry" FontWeight="SemiBold" Margin="0,0,0,6" />
                        <TextBlock x:Name="SelectionPreviewNoteText" Grid.Row="1" TextWrapping="Wrap"
                                   Foreground="#FF555555" Margin="0,0,0,8"
                                   Text="Select a structure block to highlight its best-effort page geometry when available." />
                        <Border Grid.Row="2" BorderBrush="#FFD0D0D0" BorderThickness="1"
                                Background="#FFF5F5F5" Padding="6">
                            <Image x:Name="SelectionPreviewImage" Stretch="Uniform"
                                   HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>
            <TabItem Header="Tree">
                <TreeView x:Name="StructureTreeControl">
                    <TreeView.ItemTemplate>
                        <TreeDataTemplate x:DataType="validation:StructureNode" ItemsSource="{Binding Children}">
                            <TextBlock Text="{Binding Converter={StaticResource StructureSummaryConverter}}"
                                       FontFamily="{x:Static local:Fonts.Monospace}" FontSize="12" />
                        </TreeDataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>
            </TabItem>
        </TabControl>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button x:Name="ExportJsonButton" Content="Export JSON…" Padding="12,4" Margin="0,0,8,0"
                    Click="ExportJsonButton_Click"
                    ToolTip.Tip="Save this hierarchy as JSON — useful for feeding to an AI agent or other tooling." />
            <Button Content="Close" Padding="12,4" IsCancel="True" Click="CloseButton_Click" />
        </StackPanel>
    </Grid>
</Window>
