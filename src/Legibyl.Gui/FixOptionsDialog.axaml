<Window x:Class="Legibyl.Gui.FixOptionsDialog"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Fix PDF" Width="520" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False" ShowInTaskbar="False">
    <Grid Margin="14" RowDefinitions="Auto,*,Auto">

        <TextBlock Text="Choose the repairs to apply to a copy of this PDF:"
                   TextWrapping="Wrap" Margin="0,0,0,12" />

        <StackPanel Grid.Row="1">
            <CheckBox x:Name="MetadataCheckBox" Margin="0,0,0,10">
                <TextBlock TextWrapping="Wrap"
                           Text="Fix XMP metadata using veraPDF (metadata stream, PDF/UA identifier, Info sync)" />
            </CheckBox>
            <CheckBox x:Name="AnnotationTabsCheckBox" Margin="0,0,0,10"
                      Content="Set /Tabs /S on pages that contain annotations" />
            <CheckBox x:Name="EmptyParagraphsCheckBox" Margin="0,0,0,10"
                      Content="Remove empty semantic /P structure elements (optional cleanup)" />

            <TextBlock Foreground="#FF555555" TextWrapping="Wrap" Margin="0,8,0,16"
                       Text="These repairs are best-effort structural cleanup. They do not add missing alt text, retag untagged content, or infer table headers." />
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" MinWidth="82" Margin="0,0,8,0" IsCancel="True"
                    HorizontalContentAlignment="Center" Click="CancelButton_Click" />
            <Button Content="Continue…" MinWidth="96" IsDefault="True"
                    HorizontalContentAlignment="Center" Click="ContinueButton_Click" />
        </StackPanel>
    </Grid>
</Window>
