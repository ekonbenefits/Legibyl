<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Legibyl.Validation\Legibyl.Validation.fsproj" />
    <ProjectReference Include="..\Legibyl.Rendering\Legibyl.Rendering.fsproj" />
    <ProjectReference Include="..\Legibyl.Layout\Legibyl.Layout.fsproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <!-- The .exe's icon (Explorer, taskbar, and the MSI's shortcuts). -->
    <ApplicationIcon>..\..\assets\Legibyl.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Fonts.fs" />
    <Compile Include="Theme.fs" />
    <Compile Include="Icons.fs" />
    <Compile Include="Dialogs.fs" />
    <Compile Include="StructureCache.fs" />
    <Compile Include="Dismissals.fs" />
    <Compile Include="RegionEdits.fs" />
    <Compile Include="BusyStatus.fs" />
    <Compile Include="DocumentReview.fs" />
    <Compile Include="FindingMarkers.fs" />
    <Compile Include="StructureTreeWindow.fs" />
    <Compile Include="LinkTitleOffer.fs" />
    <Compile Include="RecentFiles.fs" />
    <Compile Include="MainWindow.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>

  <ItemGroup>
    <!-- Cross-platform UI (Windows, macOS, Linux) - MIT. Views are written in F# with FuncUI. -->
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <!-- Semi Design theme (light and dark) - MIT. -->
    <PackageReference Include="Semi.Avalonia" />
    <PackageReference Include="Avalonia.FuncUI" />
    <!-- Builds Legibyl.app on `dotnet msbuild -t:BundleApp` (see README "macOS app") - MIT. Build-time only. -->
    <PackageReference Include="Dotnet.Bundle" PrivateAssets="all" />
  </ItemGroup>

  <!-- macOS .app bundle (Info.plist values for Dotnet.Bundle). Unsigned for now. -->
  <PropertyGroup>
    <CFBundleName>Legibyl</CFBundleName>
    <CFBundleDisplayName>Legibyl</CFBundleDisplayName>
    <CFBundleIdentifier>com.ekonbenefits.legibyl</CFBundleIdentifier>
    <CFBundleVersion>$(Version)</CFBundleVersion>
    <CFBundleShortVersionString>$(VersionPrefix)</CFBundleShortVersionString>
    <!-- Dotnet.Bundle's default is the typo "AAPL". -->
    <CFBundlePackageType>APPL</CFBundlePackageType>
    <CFBundleExecutable>$(AssemblyName)</CFBundleExecutable>
    <CFBundleIconFile>Legibyl.icns</CFBundleIconFile>
    <NSHighResolutionCapable>true</NSHighResolutionCapable>
  </PropertyGroup>

  <!--
    Declares that Legibyl opens PDFs, so Finder offers it under Open With, as an alternative
    (LSHandlerRank Alternate: it never becomes their default app). Dotnet.Bundle has no setting
    for document types, so they're added to the Info.plist it writes.
  -->
  <Target Name="AddPdfDocumentType" AfterTargets="BundleApp">
    <PropertyGroup>
      <InfoPlist>$(PublishDir)$(CFBundleName).app/Contents/Info.plist</InfoPlist>
      <PlistBuddy>/usr/libexec/PlistBuddy</PlistBuddy>
    </PropertyGroup>
    <Exec Command="$(PlistBuddy) -c &quot;Delete :CFBundleDocumentTypes&quot; &quot;$(InfoPlist)&quot;" IgnoreExitCode="true" StandardErrorImportance="low" StandardOutputImportance="low" />
    <Exec Command="$(PlistBuddy) -c &quot;Add :CFBundleDocumentTypes array&quot; -c &quot;Add :CFBundleDocumentTypes:0 dict&quot; -c &quot;Add :CFBundleDocumentTypes:0:CFBundleTypeName string PDF document&quot; -c &quot;Add :CFBundleDocumentTypes:0:CFBundleTypeRole string Viewer&quot; -c &quot;Add :CFBundleDocumentTypes:0:LSHandlerRank string Alternate&quot; -c &quot;Add :CFBundleDocumentTypes:0:LSItemContentTypes array&quot; -c &quot;Add :CFBundleDocumentTypes:0:LSItemContentTypes:0 string com.adobe.pdf&quot; &quot;$(InfoPlist)&quot;" />
  </Target>

  <ItemGroup Condition="$(RuntimeIdentifier.StartsWith('osx'))">
    <None Include="..\..\assets\Legibyl.icns" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
