<Window x:Class="Legibyl.Gui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Legibyl.Gui"
        mc:Ignorable="d"
        Title="Legibyl — PDF/UA Validator" Height="720" Width="1200"
        MinHeight="560" MinWidth="900"
        AllowDrop="True" Drop="Window_Drop" DragOver="Window_DragOver">
    <Window.Resources>
        <Style x:Key="StatusBannerStyle" TargetType="Border">
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- File picker row -->
        <Grid Grid.Row="0" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="FilePathTextBox" Grid.Column="0" Margin="0,0,8,0"
                     VerticalContentAlignment="Center"
                     IsReadOnly="True"
                     Text="Drop a PDF here or click Browse..." />
            <Button x:Name="BrowseButton" Grid.Column="1" Content="Browse…" Padding="12,4" Margin="0,0,8,0"
                    Click="BrowseButton_Click" />
            <ComboBox x:Name="ProfileComboBox" Grid.Column="2" Width="160" Margin="0,0,8,0"
                      SelectedIndex="0" SelectionChanged="ProfileComboBox_SelectionChanged" />
            <Button x:Name="ValidateButton" Grid.Column="3" Content="Validate" Padding="16,4"
                    Click="ValidateButton_Click" IsEnabled="False" />
        </Grid>

        <!-- Progress -->
        <ProgressBar x:Name="ProgressBar" Grid.Row="1" Height="4" Margin="0,0,0,8"
                     IsIndeterminate="True" Visibility="Collapsed" />

        <!-- Status banner -->
        <Border x:Name="StatusBanner" Grid.Row="2" Style="{StaticResource StatusBannerStyle}"
                Visibility="Collapsed">
            <TextBlock x:Name="StatusText" FontWeight="Bold" TextWrapping="Wrap" />
        </Border>

        <!-- Results and selected-finding details -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="5*" MinWidth="360" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="7*" MinWidth="420" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <ListView x:Name="ResultsListView" Grid.Row="0"
                          SelectionChanged="ResultsListView_SelectionChanged">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="ToolTip" Value="{Binding Message}" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Clause" Width="80" DisplayMemberBinding="{Binding Clause}" />
                            <GridViewColumn Header="Test" Width="48" DisplayMemberBinding="{Binding TestNumber}" />
                            <GridViewColumn Header="Page" Width="62" DisplayMemberBinding="{Binding PageDisplay}" />
                            <GridViewColumn Header="Location" Width="260">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding FriendlyLocation}" TextWrapping="Wrap"
                                                   Margin="0,3" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>

                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right"
                            Margin="0,8,0,0">
                    <Button x:Name="CopySummaryButton" Content="Copy Summary" Padding="12,4"
                            Margin="0,0,8,0" Click="CopySummaryButton_Click" IsEnabled="False" />
                    <Button x:Name="SaveReportButton" Content="Save Report…" Padding="12,4"
                            Click="SaveReportButton_Click" IsEnabled="False" />
                </StackPanel>
            </Grid>

            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch"
                          Background="#FFE0E0E0" ResizeBehavior="PreviousAndNext" />

            <Grid x:Name="FindingDetailsPanel" Grid.Column="2" Margin="12,0,0,0"
                  Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock x:Name="FindingHeadingText" FontSize="16" FontWeight="SemiBold"
                                   TextWrapping="Wrap" Margin="0,0,0,8" />
                        <TextBlock Text="Message" FontWeight="SemiBold" />
                        <TextBox x:Name="FindingMessageText" IsReadOnly="True" TextWrapping="Wrap"
                                 MaxHeight="130" VerticalScrollBarVisibility="Auto"
                                 BorderThickness="0" Background="Transparent" Padding="0,2" />
                        <TextBlock Text="Location" FontWeight="SemiBold" Margin="0,8,0,0" />
                        <TextBox x:Name="FindingLocationText" IsReadOnly="True" TextWrapping="Wrap"
                                 BorderThickness="0" Background="Transparent" Padding="0,2"
                                 Foreground="#FF555555" />
                        <TextBlock Text="Raw location" FontWeight="SemiBold" Margin="0,8,0,0" />
                        <TextBox x:Name="FindingRawLocationText" IsReadOnly="True" TextWrapping="Wrap"
                                 MaxHeight="90" VerticalScrollBarVisibility="Auto"
                                 BorderThickness="0" Background="Transparent" Padding="0,2"
                                 FontFamily="Consolas" FontSize="12" Foreground="#FF555555" />
                    </StackPanel>

                    <Button x:Name="CopyFindingButton" Grid.Column="1" Content="Copy Finding"
                            Padding="12,4" Margin="12,0,0,0" VerticalAlignment="Top"
                            Click="CopyFindingButton_Click" IsEnabled="False" />
                </Grid>

                <ProgressBar x:Name="PreviewProgressBar" Grid.Row="1" Height="4"
                             IsIndeterminate="True" Visibility="Collapsed" Margin="0,0,0,8" />

                <TextBlock x:Name="PreviewNoteText" Grid.Row="2" TextWrapping="Wrap"
                           Margin="0,0,0,8" Foreground="#FF555555" />

                <Border Grid.Row="3" BorderBrush="#FFD0D0D0" BorderThickness="1"
                        Background="#FFF5F5F5" Padding="6">
                    <Image x:Name="RegionImage" Stretch="Uniform"
                           HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                </Border>
            </Grid>
        </Grid>

        <!-- Bottom action bar -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button x:Name="ViewStructureButton" Content="View Structure…" Padding="12,4" Margin="0,0,8,0"
                    Click="ViewStructureButton_Click" IsEnabled="False"
                    ToolTip="Shows the tagged logical structure tree (the semantic heading/paragraph/list/table/link hierarchy a screen reader uses) and lets you export it as JSON." />
            <Button x:Name="FixButton" Content="Fix…" Padding="12,4" Margin="0,0,8,0"
                    Click="FixButton_Click" IsEnabled="False"
                    ToolTip="Opens a dialog of selectable best-effort repairs, including XMP metadata, page annotation tab order, and empty paragraph tags. Disabled once the file is already fully compliant, since there'd be nothing left to fix." />
        </StackPanel>
    </Grid>
</Window>
