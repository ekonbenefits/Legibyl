<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Pdfium.fs" />
    <Compile Include="PdfRegionRenderer.fs" />
  </ItemGroup>

  <ItemGroup>
    <!-- Pure managed PDF parsing (text, positions, annotations) - Apache 2.0. -->
    <PackageReference Include="PdfPig" />
    <!-- PDFium draws pages (Chrome's renderer; BSD-3), from bblanchon's native builds for
         Windows, Linux and macOS, into SkiaSharp bitmaps. -->
    <PackageReference Include="bblanchon.PDFium.Linux" />
    <PackageReference Include="bblanchon.PDFium.macOS" />
    <PackageReference Include="bblanchon.PDFium.Win32" />
    <PackageReference Include="SkiaSharp" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Legibyl.Validation\Legibyl.Validation.fsproj" />
  </ItemGroup>

</Project>
