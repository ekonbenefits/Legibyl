<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Pdfium.fs" />
    <Compile Include="PdfRegionRenderer.fs" />
  </ItemGroup>

  <ItemGroup>
    <!-- Pure managed PDF parsing (text, positions, annotations) - Apache 2.0. -->
    <PackageReference Include="PdfPig" />
    <!-- PDFium (from Legibyl.Validation, which draws with it too) draws pages into SkiaSharp
         bitmaps. -->
    <PackageReference Include="SkiaSharp" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Legibyl.Validation\Legibyl.Validation.fsproj" />
  </ItemGroup>

</Project>
