<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="PdfRegionRenderer.fs" />
  </ItemGroup>

  <ItemGroup>
    <!-- Pure managed PDF parsing/rendering (no native PDFium/etc. binaries) - Apache 2.0. -->
    <PackageReference Include="PdfPig" Version="0.1.16" />
    <PackageReference Include="PdfPig.Rendering.Skia" Version="0.1.16.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Legibyl.Validation\Legibyl.Validation.fsproj" />
  </ItemGroup>

</Project>
