<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="TableStructure.fs" />
    <Compile Include="LayoutSuggestions.fs" />
  </ItemGroup>

  <ItemGroup>
    <!-- A pure C# port of PaddleOCR's layout detector (PP-DocLayoutV3) - Apache 2.0. Its model is
         downloaded on first use, not shipped. -->
    <PackageReference Include="PaddleOCR" />
    <!-- ONNX Runtime (MIT), for the table-structure model (Table Transformer, MIT), downloaded on
         first use, not shipped. Native builds for every platform Legibyl supports. -->
    <PackageReference Include="Microsoft.ML.OnnxRuntime" />
    <!-- Tesseract OCR (Apache 2.0) with native binaries for win-x64/arm64, linux-x64/arm64 and
         osx-arm64, for regions whose text is drawn as outlines or pixels. -->
    <PackageReference Include="Tesseract.CrossPlatform" />
    <!-- Decodes QR codes in figures, to describe them and link them (Apache 2.0). -->
    <PackageReference Include="ZXing.Net" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Legibyl.Rendering\Legibyl.Rendering.fsproj" />
  </ItemGroup>

  <!-- The English OCR model, pinned by TessdataVersion/TessdataEngSha256 in
       Directory.Build.props, cached under obj/ and copied to the output's tessdata/. -->
  <PropertyGroup>
    <TessdataEngUrl>https://raw.githubusercontent.com/tesseract-ocr/tessdata_fast/$(TessdataVersion)/eng.traineddata</TessdataEngUrl>
    <TessdataDir>$(MSBuildProjectDirectory)/$(BaseIntermediateOutputPath)tessdata/$(TessdataVersion)/</TessdataDir>
    <TessdataEng>$(TessdataDir)eng.traineddata</TessdataEng>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(TessdataEng)" Link="tessdata/eng.traineddata" CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>

  <Target Name="FetchTessdata" BeforeTargets="AssignTargetPaths;GetCopyToOutputDirectoryItems" Condition="!Exists('$(TessdataEng)')">
    <DownloadFile SourceUrl="$(TessdataEngUrl)" DestinationFolder="$(TessdataDir)" DestinationFileName="eng.traineddata.download" Retries="3" />
    <GetFileHash Files="$(TessdataEng).download" Algorithm="SHA256">
      <Output TaskParameter="Hash" PropertyName="_TessdataActualSha256" />
    </GetFileHash>
    <Delete Files="$(TessdataEng).download" Condition="'$(_TessdataActualSha256)' != '$(TessdataEngSha256)'" />
    <Error Condition="'$(_TessdataActualSha256)' != '$(TessdataEngSha256)'"
           Text="SHA-256 mismatch for $(TessdataEngUrl): expected $(TessdataEngSha256), got $(_TessdataActualSha256). If you are upgrading tessdata, update TessdataEngSha256 in Directory.Build.props." />
    <Move SourceFiles="$(TessdataEng).download" DestinationFiles="$(TessdataEng)" />
  </Target>

  <!-- Suggest Structure's models, pinned in Directory.Build.props, cached under obj/ and copied
       to the output's models/ (see LayoutModel and TableModel, which look there first). -->
  <PropertyGroup>
    <BundledModelsDir>$(MSBuildProjectDirectory)/$(BaseIntermediateOutputPath)models/</BundledModelsDir>
    <LayoutModelUrl>https://huggingface.co/PaddlePaddle/PP-DocLayoutV3/resolve/$(LayoutModelRevision)</LayoutModelUrl>
    <TableModelUrl>https://huggingface.co/Xenova/table-transformer-structure-recognition/resolve/$(TableModelRevision)/onnx</TableModelUrl>
  </PropertyGroup>

  <ItemGroup>
    <BundledModel Include="pp-doclayoutv3/inference.json" Folder="pp-doclayoutv3" Url="$(LayoutModelUrl)/inference.json" Sha256="$(LayoutModelJsonSha256)" />
    <BundledModel Include="pp-doclayoutv3/inference.pdiparams" Folder="pp-doclayoutv3" Url="$(LayoutModelUrl)/inference.pdiparams" Sha256="$(LayoutModelParamsSha256)" />
    <BundledModel Include="pp-doclayoutv3/inference.yml" Folder="pp-doclayoutv3" Url="$(LayoutModelUrl)/inference.yml" Sha256="$(LayoutModelYmlSha256)" />
    <BundledModel Include="table-transformer-structure-recognition/model_quantized.onnx" Folder="table-transformer-structure-recognition" Url="$(TableModelUrl)/model_quantized.onnx" Sha256="$(TableModelSha256)" />
    <None Include="$(BundledModelsDir)pp-doclayoutv3/inference.json" Link="models/pp-doclayoutv3/inference.json" CopyToOutputDirectory="PreserveNewest" Visible="false" />
    <None Include="$(BundledModelsDir)pp-doclayoutv3/inference.pdiparams" Link="models/pp-doclayoutv3/inference.pdiparams" CopyToOutputDirectory="PreserveNewest" Visible="false" />
    <None Include="$(BundledModelsDir)pp-doclayoutv3/inference.yml" Link="models/pp-doclayoutv3/inference.yml" CopyToOutputDirectory="PreserveNewest" Visible="false" />
    <None Include="$(BundledModelsDir)table-transformer-structure-recognition/model_quantized.onnx" Link="models/table-transformer-structure-recognition/model_quantized.onnx" CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>

  <Target Name="FetchBundledModels" BeforeTargets="AssignTargetPaths;GetCopyToOutputDirectoryItems">
    <DownloadFile SourceUrl="%(BundledModel.Url)" DestinationFolder="$(BundledModelsDir)%(BundledModel.Folder)" DestinationFileName="%(BundledModel.Filename)%(BundledModel.Extension).download" Retries="3" Condition="!Exists('$(BundledModelsDir)%(BundledModel.Identity)')" />
    <VerifyFileHash File="$(BundledModelsDir)%(BundledModel.Identity).download" Hash="%(BundledModel.Sha256)" Algorithm="SHA256" Condition="!Exists('$(BundledModelsDir)%(BundledModel.Identity)')" />
    <Move SourceFiles="$(BundledModelsDir)%(BundledModel.Identity).download" DestinationFiles="$(BundledModelsDir)%(BundledModel.Identity)" Condition="!Exists('$(BundledModelsDir)%(BundledModel.Identity)')" />
  </Target>

</Project>
