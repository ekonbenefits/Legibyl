<Window x:Class="VeraPdfTool.Gui.RegionPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Page Region" Height="800" Width="900"
        WindowStartupLocation="CenterOwner">
    <DockPanel Margin="8">
        <Border x:Name="NoteBanner" DockPanel.Dock="Top" Background="#FFF3F3F3" Padding="8" Margin="0,0,0,8">
            <TextBlock x:Name="NoteText" TextWrapping="Wrap" />
        </Border>
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
            <Image x:Name="PageImage" Stretch="None" />
        </ScrollViewer>
    </DockPanel>
</Window>
