<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs" xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package Id="Ekon.Legibyl_Install"
            Name="Legibyl"
            Manufacturer="Ekon Benefits"
            Version="$(var.AppVersion)"
            Language="1033"
            UpgradeCode="{B48C996B-B138-4667-AE40-27833489C272}">

    <SummaryInformation Comments="Version ($(var.FullVersion))" />
    <MediaTemplate EmbedCab="yes" />
    <Icon Id="LegibylIcon" SourceFile="$(var.RepoRoot)assets\Legibyl.ico" />
    <!-- Advertised shortcuts take their icon from here; ICE50 requires its extension to match the key file's (.exe). -->
    <Icon Id="LegibylShortcut.exe" SourceFile="$(var.GuiPublishDir)\Legibyl.Gui.exe" />
    <!-- Shown in Settings > Apps (Add/Remove Programs). -->
    <Property Id="ARPPRODUCTICON" Value="LegibylIcon" />
    <MajorUpgrade DowngradeErrorMessage="!(loc.DowngradeError)" />
    <ui:WixUI Id="WixUI_Minimal" />
    <WixVariable Id="WixUILicenseRtf" Value="license.rtf" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Launch Legibyl" />
    <Property Id="WixShellExecTarget" Value="[#MainExe]" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />

    <Feature Id="Main">
      <ComponentGroupRef Id="GuiPayload" />
      <ComponentGroupRef Id="LicenseFiles" />
    </Feature>

    <UI>
      <Publish Dialog="ExitDialog"
                Control="Finish"
                Event="DoAction"
                Value="LaunchApplication"
                Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 and NOT Installed" />
    </UI>
  </Package>
</Wix>
