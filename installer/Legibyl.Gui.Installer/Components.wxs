<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Fragment>

    <ComponentGroup Id="GuiPayload" Directory="INSTALLFOLDER">

      <Component Id="MainExecutableComponent" Guid="*">
        <File Id="MainExe"
              Source="$(var.GuiPublishDir)\Legibyl.Gui.exe"
              KeyPath="yes">

          <Shortcut Id="StartMenuShortcut"
                    Directory="InstallProgramMenuFolder"
                    Name="Legibyl"
                    WorkingDirectory="INSTALLFOLDER"
                    Icon="LegibylIcon"
                    Advertise="yes" />

          <Shortcut Id="DesktopShortcut"
                    Directory="DesktopFolder"
                    Name="Legibyl"
                    WorkingDirectory="INSTALLFOLDER"
                    Icon="LegibylIcon"
                    Advertise="yes" />
        </File>

        <RemoveFolder Id="CleanUpShortCut" Directory="InstallProgramMenuFolder" On="uninstall" />
      </Component>

      <!--
        Offers Legibyl for PDFs under right-click › Open with, without becoming their default app:
        a file type of its own (Legibyl.pdf) that opens a PDF with the path as its argument, listed
        among .pdf's OpenWithProgids, and the app's own entry saying it takes .pdf. Removed on
        uninstall with the rest.
      -->
      <Component Id="PdfOpenWithComponent" Guid="*">
        <RegistryKey Root="HKLM" Key="Software\Classes\Legibyl.pdf">
          <RegistryValue Type="string" Value="PDF document" KeyPath="yes" />
          <RegistryKey Key="DefaultIcon">
            <RegistryValue Type="string" Value="&quot;[#MainExe]&quot;,0" />
          </RegistryKey>
          <RegistryKey Key="shell\open\command">
            <RegistryValue Type="string" Value="&quot;[#MainExe]&quot; &quot;%1&quot;" />
          </RegistryKey>
        </RegistryKey>
        <!-- The values' data isn't read: only their names are. -->
        <RegistryValue Root="HKLM" Key="Software\Classes\.pdf\OpenWithProgids" Name="Legibyl.pdf" Type="string" Value="Legibyl" />
        <RegistryKey Root="HKLM" Key="Software\Classes\Applications\Legibyl.Gui.exe">
          <RegistryValue Name="FriendlyAppName" Type="string" Value="Legibyl" />
          <RegistryKey Key="SupportedTypes">
            <RegistryValue Name=".pdf" Type="string" Value="Legibyl" />
          </RegistryKey>
          <RegistryKey Key="shell\open\command">
            <RegistryValue Type="string" Value="&quot;[#MainExe]&quot; &quot;%1&quot;" />
          </RegistryKey>
        </RegistryKey>
      </Component>

      <!-- Everything else from the self-contained publish output (IKVM.Java.dll, translated jar, .NET runtime files, etc.) -->
      <Files Include="$(var.GuiPublishDir)\**\*">
        <Exclude Files="$(var.GuiPublishDir)\Legibyl.Gui.exe" />
      </Files>
    </ComponentGroup>

    <!--
      Our own AGPL-3.0-or-later license plus veraPDF's dual GPLv3+/MPLv2+ texts and the
      third-party NOTICE (attribution + source pointer for the bundled jar).
      Installed alongside the app so the license.rtf shown during setup isn't
      the only copy a recipient of the installed product has access to.
    -->
    <ComponentGroup Id="LicenseFiles" Directory="LicensesFolder">
      <Files Include="$(var.RepoRoot)LICENSE" />
      <Files Include="$(var.RepoRoot)licenses\*" />
    </ComponentGroup>
  </Fragment>
</Wix>
